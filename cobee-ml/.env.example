# Local development example. Replace these values in .env before use.
# MSA Gateway base URL. It must route /sync/members and /sync/**.
MSA_BACKEND_URL=http://127.0.0.1:8080
# Use the same value in the MSA Gateway, member service, and recruit service.
SYNC_SECRET_KEY=replace-with-local-sync-key

# ML PostgreSQL. These values are also used by docker-compose.yml.
# POSTGRES_HOST is the address used by the Python process on the host.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cobee_ml
POSTGRES_USER=cobee_ml
POSTGRES_PASSWORD=replace-with-local-db-password

# Optional. Relative to the cobee-ml working directory.
MODEL_PATH=models/svd_model.pkl
